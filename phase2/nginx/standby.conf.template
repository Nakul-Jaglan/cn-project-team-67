# Standby edge, Mac 3 (Neelanshu). Extension E.
# See README.md for certificate and log paths.
worker_processes 1;
pid "@STANDBY_DIR@/nginx.pid";

events {
    worker_connections 1024;
}

http {
    access_log "@STANDBY_DIR@/access.log";
    error_log "@STANDBY_DIR@/error.log" info;

    upstream phase1_backends {
        server 127.0.0.1:3001 max_fails=1 fail_timeout=5s;
        server 100.97.35.89:3002 max_fails=1 fail_timeout=5s;

        keepalive 8;
    }

    server {
        listen 8443 ssl;

        server_name app.team67.test api.team67.test;

        ssl_certificate "@STANDBY_DIR@/standby.crt";
        ssl_certificate_key "@STANDBY_DIR@/standby.key";

        ssl_protocols TLSv1.2 TLSv1.3;

        add_header X-Edge standby always;

        location / {
            proxy_pass http://phase1_backends;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            proxy_connect_timeout 2s;
            proxy_read_timeout 10s;

            proxy_next_upstream
                error timeout http_502 http_503 http_504;

            proxy_next_upstream_tries 2;
        }
    }
}
